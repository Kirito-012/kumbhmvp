# Keep local installs on the same flat layout CI uses (the workflow passes
# --node-linker=hoisted), so what gets built and traced locally matches what ships.
#
# Note this does NOT by itself make Next's standalone output portable: the tracer
# still emits node_modules/next as a symlink into pnpm's .pnpm store using an
# absolute path. Flattening that is the deploy workflow's job — it archives with
# `tar -h` to dereference symlinks into real files.
node-linker=hoisted
