MONGODB_URI=
AUTH_SECRET=
POSTGRES_URL=

# Auth.js refuses to trust a proxied Host header unless told to. Behind a reverse proxy
# (Azure App Service, Vercel, nginx) the host arrives as X-Forwarded-Host, and without this
# every /api/auth/* request fails with UntrustedHost. Leave unset for local development.
AUTH_TRUST_HOST=
# Canonical public origin, e.g. https://your-app.azurewebsites.net — pins callback URLs and
# cookie domains to the real site instead of whatever Host header a request carries.
AUTH_URL=

# Used only by `npm run seed` to create the initial admin account
SEED_ADMIN_EMAIL=admin@thecraftsync.local
SEED_ADMIN_PASSWORD=

# Shared secret for POST /api/v1/tickets (service-to-service integrations, e.g. DroneSeva's
# garbage-detection pipeline). Same value goes in the calling app as TCS_TICKET_API_KEY.
INTEGRATION_API_KEY=

# Origin of the DroneSeva portal — used to rewrite "View in DroneSeva" ticket links to wherever
# the portal currently runs, regardless of what port it was on when the ticket was created.
DRONESEVA_PORTAL_ORIGIN=http://localhost:3010

# Public (client-bundled) key for MapTiler's "Bright" vector basemap style, used by MapView.tsx
# for light mode. Free-tier key — https://cloud.maptiler.com/account/keys/
NEXT_PUBLIC_MAPTILER_KEY=

# Cloudinary — stores Surveyor-uploaded Before/After site photos. The browser uploads directly to
# Cloudinary using a short-lived signature minted server-side (see
# src/server/services/cloudinary.service.ts); these secrets never reach the client bundle.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
